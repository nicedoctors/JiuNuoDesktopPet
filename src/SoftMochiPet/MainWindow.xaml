<Window x:Class="SoftMochiPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="啾糯桌宠"
        Width="220" Height="220"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False">
  <Grid x:Name="Root" Background="Transparent">
    <Grid x:Name="CharacterRoot"
          Margin="6"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.78"
          MouseLeftButtonDown="Character_MouseLeftButtonDown"
          MouseLeftButtonUp="Character_MouseLeftButtonUp"
          MouseMove="Character_MouseMove"
          LostMouseCapture="Character_LostMouseCapture"
          MouseRightButtonUp="Character_MouseRightButtonUp">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="FacingTransform" ScaleX="1" ScaleY="1" />
          <ScaleTransform x:Name="SquashTransform" ScaleX="1" ScaleY="1" />
          <RotateTransform x:Name="LeanTransform" Angle="0" />
        </TransformGroup>
      </Grid.RenderTransform>

      <Viewbox Stretch="Uniform" IsHitTestVisible="False">
        <Grid Width="512" Height="512">
          <Ellipse x:Name="GroundShadow"
                   Width="202" Height="30"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,27"
                   Fill="#320C1720"
                   Opacity="0.38">
            <Ellipse.Effect>
              <BlurEffect Radius="12" />
            </Ellipse.Effect>
          </Ellipse>

          <Canvas Width="512" Height="512" IsHitTestVisible="False" Panel.ZIndex="2">
            <Border x:Name="FoodVisual"
                    Canvas.Left="18" Canvas.Top="240"
                    Width="54" Height="54"
                    Padding="1"
                    Background="Transparent"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="Collapsed">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="FoodScale" ScaleX="1" ScaleY="1" />
                  <RotateTransform x:Name="FoodRotate" Angle="0" />
                </TransformGroup>
              </Border.RenderTransform>
              <Image x:Name="FoodIcon" Width="52" Height="52" Stretch="Uniform">
                <Image.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.42" Color="#442A23" />
                </Image.Effect>
              </Image>
            </Border>
          </Canvas>

          <Image x:Name="PetSprite"
                 Panel.ZIndex="1"
                 Width="512" Height="512"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="HighQuality" />

          <Canvas x:Name="PrankImpact" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False">
            <Canvas.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="PrankImpactScale" />
                <TranslateTransform x:Name="PrankImpactTranslate" />
              </TransformGroup>
            </Canvas.RenderTransform>
            <Path Data="M 0,-36 L 9,-12 L 31,-23 L 18,-3 L 39,8 L 13,12 L 7,34 L -5,16 L -28,28 L -17,5 L -37,-7 L -12,-12 Z"
                  Fill="#FFFFEDB0" Stroke="#FF397FBB" StrokeThickness="3" StrokeLineJoin="Round" />
          </Canvas>

          <Canvas x:Name="BurpPuff"
                  Panel.ZIndex="3"
                  Width="512" Height="512"
                  Opacity="0">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="BurpTranslate" />
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="84" Canvas.Top="218" Width="38" Height="29" Fill="#F7FFFFFF" Stroke="#A85E7180" StrokeThickness="2" />
            <Ellipse Canvas.Left="70" Canvas.Top="229" Width="25" Height="21" Fill="#F7FFFFFF" Stroke="#A85E7180" StrokeThickness="2" />
            <Ellipse Canvas.Left="58" Canvas.Top="239" Width="15" Height="13" Fill="#F7FFFFFF" Stroke="#A85E7180" StrokeThickness="2" />
          </Canvas>
        </Grid>
      </Viewbox>
    </Grid>

    <Border x:Name="HungerBadge"
            Panel.ZIndex="20"
            Width="126" Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,2,0,0"
            Padding="9,4"
            CornerRadius="14"
            Background="#F2FFFFFF"
            BorderBrush="#76D197"
            BorderThickness="1.5"
            IsHitTestVisible="False">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="54" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HungerText"
                   Grid.Column="0"
                   Text="饥饿 36"
                   Foreground="#3C5150"
                   FontSize="12"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />
        <ProgressBar x:Name="HungerBar"
                     Grid.Column="2"
                     Height="7"
                     Minimum="0" Maximum="100" Value="36"
                     Foreground="#76D197"
                     Background="#2476D197"
                     BorderThickness="0"
                     VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border x:Name="MischiefBadge"
            Panel.ZIndex="20"
            Width="120" Height="26"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,2,0,0" Padding="9,4" CornerRadius="13"
            Background="#F2FFFFFF" BorderBrush="#A68CE1" BorderThickness="1.5"
            Visibility="Collapsed" IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="MischiefBadgeScale" />
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="捣蛋" Foreground="#735598"
                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
        <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="#247EA6E8"
                VerticalAlignment="Center" ClipToBounds="True">
          <Grid>
            <Border x:Name="MischiefBarFill" HorizontalAlignment="Left"
                    Width="0" CornerRadius="3.5">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#77AFE9" Offset="0" />
                  <GradientStop Color="#B28CE5" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

  </Grid>
</Window>
