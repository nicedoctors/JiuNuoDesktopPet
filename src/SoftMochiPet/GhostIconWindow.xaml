<Window x:Class="SoftMochiPet.GhostIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="48" Height="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
  <Grid x:Name="GhostRoot" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="GhostScale" ScaleX="1" ScaleY="1" />
        <RotateTransform x:Name="GhostRotate" Angle="0" />
      </TransformGroup>
    </Grid.RenderTransform>
    <Canvas x:Name="GhostCanvas">
      <Image x:Name="GhostImage"
             Stretch="Uniform"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock x:Name="GhostLabel"
                 FontFamily="Segoe UI"
                 FontSize="12"
                 Foreground="White"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis"
                 LineHeight="16"
                 LineStackingStrategy="BlockLineHeight"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
        <TextBlock.Effect>
          <DropShadowEffect Color="Black"
                            Direction="315"
                            ShadowDepth="1"
                            BlurRadius="1.2"
                            Opacity="1" />
        </TextBlock.Effect>
      </TextBlock>
    </Canvas>
  </Grid>
</Window>
