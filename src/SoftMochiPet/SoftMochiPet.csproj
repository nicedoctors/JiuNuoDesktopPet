<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF requires the manifest for early PMv2 activation; WFAC010 is a
         WinForms analyzer false positive caused by the tray-icon reference. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoftMochiPet</RootNamespace>
    <AssemblyName>啾糯桌宠</AssemblyName>
    <AssemblyTitle>啾糯桌宠</AssemblyTitle>
    <Product>啾糯桌宠</Product>
    <Version>1.3.3</Version>
    <FileVersion>1.3.3.0</FileVersion>
    <InformationalVersion>1.3.3+20261001</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>与糯糯和菲比啾比一起生活在 Windows 里</Description>
    <Company>nicedoctors</Company>
    <Authors>nicedoctors</Authors>
    <Copyright>Copyright © 2026 桃天帝不差</Copyright>
    <ApplicationIcon>..\..\assets\pet.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\audio\voice-levels.json">
      <Link>assets\audio\voice-levels.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\pair_interactions\calibration.json">
      <Link>assets\pair_interactions\calibration.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\pet.ico">
      <Link>assets\pet.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\sprites\runtime\**\*.png" Exclude="..\..\assets\sprites\runtime\pinch\**">
      <Link>assets\sprites\runtime\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\pair_interactions\props\*.png">
      <Link>assets\pair_interactions\props\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\音效\*.wav">
      <Link>assets\audio\voice\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\runtime\**\*.png"
             Exclude="..\..\assets\characters\feibijiubi\runtime\hungry\**;..\..\assets\characters\feibijiubi\runtime\lick\**;..\..\assets\characters\feibijiubi\runtime\chomp\**;..\..\assets\characters\feibijiubi\runtime\satisfied\**;..\..\assets\characters\feibijiubi\runtime\pinch\**;..\..\assets\characters\feibijiubi\runtime\pinch_right\**">
      <Link>assets\characters\feibijiubi\runtime\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\prank-animations.json"
             Condition="Exists('..\..\assets\characters\feibijiubi\prank-animations.json')">
      <Link>assets\characters\feibijiubi\prank-animations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\props\*.png">
      <Link>assets\characters\feibijiubi\props\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\runtime-masks\**\*.png">
      <Link>assets\characters\feibijiubi\runtime-masks\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\audio\*.wav">
      <Link>assets\characters\feibijiubi\audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\characters\feibijiubi\pet.ico">
      <Link>assets\characters\feibijiubi\pet.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
